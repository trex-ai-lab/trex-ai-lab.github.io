---
import { news } from "../data/news";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Filter out expired news items based on current date
const now = new Date();
const activeNews = news.filter((item) => {
  if (!item.expires) return true;
  const exp = new Date(item.expires);
  // Compare by end of the expiration day (UTC)
  exp.setHours(23, 59, 59, 999);
  return now <= exp;
});

const isTR = lang === "tr";
---

{
  activeNews.length > 0 && (
    <aside class="news-ticker-wrap" aria-label={isTR ? "Son Gelişmeler" : "Latest Lab News"}>
      <div class="wrap ticker-container">
        <div class="ticker-badge">
          <span class="live-dot" aria-hidden="true"></span>
          <span class="badge-label">{isTR ? "// duyuru" : "// news"}</span>
        </div>

        <div class="ticker-viewport">
          <div class="ticker-track">
            {/* Render items twice to ensure a seamless infinite marquee */}
            {[0, 1].map(() => (
              <div class="ticker-content" aria-hidden="false">
                {activeNews.map((item) => {
                  const tag = isTR ? item.tag_tr : item.tag_en;
                  const title = isTR ? item.title_tr : item.title_en;
                  return (
                    <span class="ticker-item">
                      <span class="item-tag">[{tag}]</span>
                      {item.href ? (
                        <a href={item.href} class="item-link" target="_blank" rel="noopener">
                          {title} <span class="arrow">↗</span>
                        </a>
                      ) : (
                        <span class="item-text">{title}</span>
                      )}
                      <span class="item-sep" aria-hidden="true">///</span>
                    </span>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>
    </aside>
  )
}

<style>
  .news-ticker-wrap {
    background: var(--bg-card);
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    position: relative;
    z-index: 40;
    overflow: hidden;
  }

  .ticker-container {
    display: flex;
    align-items: center;
    min-height: 2.2rem;
    gap: 0.75rem;
  }

  .ticker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    padding: 0.2rem 0.55rem;
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 3px;
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    user-select: none;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }

  .ticker-viewport {
    flex: 1;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 2%,
      black 98%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 2%,
      black 98%,
      transparent 100%
    );
  }

  .ticker-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: scroll-left 42s linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-content {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    gap: 0.5rem;
  }

  .item-tag {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.72rem;
  }

  .item-text,
  .item-link {
    color: var(--text);
    text-decoration: none;
  }

  .item-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .item-sep {
    color: var(--line-strong);
    margin: 0 1.25rem;
    font-weight: 700;
    user-select: none;
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
    .ticker-viewport {
      overflow-x: auto;
    }
  }

  @media (max-width: 640px) {
    .ticker-container {
      gap: 0.5rem;
      min-height: 2rem;
    }
    .ticker-badge {
      font-size: 0.65rem;
      padding: 0.15rem 0.4rem;
    }
    .badge-label {
      display: none;
    }
    .ticker-item {
      font-size: 0.76rem;
    }
  }
</style>
