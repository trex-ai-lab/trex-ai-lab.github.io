---
/**
 * Interactive research terminal — the homepage centerpiece.
 * Works with the keyboard (type commands), with clicks (command chips + links),
 * and degrades to a static, crawlable initial transcript when JS is off.
 */
import type { Lang } from "../i18n/ui";

interface ConsoleData {
  lang: Lang;
  about: string;
  hint: string;
  notFound: string;
  helpTitle: string;
  help: { cmd: string; desc: string }[];
  sections: { name: string; url: string }[];
  projects: string[];
  papers: { label: string; year: number; href: string }[];
  team: { name: string; role: string }[];
  blog: { title: string; date: string; href: string }[];
  contact: { email: string; links: { label: string; href: string }[] };
  altLangHome: string;
  altLangLabel: string;
}

interface Props {
  data: ConsoleData;
  title?: string;
}
const { data, title = "trex.ai — bash — 80×24" } = Astro.props;
const chips = ["help", "whoami", "projects", "papers", "team", "contact"];
---

<div class="term win scanlines">
  <div class="win-bar">
    <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win-title">{title}</span>
  </div>

  <div class="term-screen">
    <div class="term-banner">
      <img
        src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/logo-horizontal-dark.png`}
        alt="trex.ai — Trustworthy & Explainable AI Lab"
        class="term-logo-lockup"
        width="1018"
        height="234"
      />
    </div>

    <div class="term-out" id="term-out" role="log" aria-live="polite">
      <!-- server-rendered initial transcript (no-JS + SEO) -->
      <div class="ln"><span class="prompt">trex.ai:~$</span> whoami</div>
      <div class="ln out">{data.about}</div>
      <div class="ln"></div>
      <div class="ln"><span class="muted">{data.hint}</span></div>
    </div>

    <form class="term-in" id="term-form" autocomplete="off">
      <label class="prompt" for="term-input">trex.ai:~$</label>
      <input
        id="term-input"
        class="term-input"
        type="text"
        spellcheck="false"
        autocapitalize="off"
        aria-label="Terminal command input"
        placeholder="type a command…"
      />
      <span class="caret" aria-hidden="true"></span>
    </form>
  </div>

  <div class="term-chips" id="term-chips">
    {chips.map((c) => <button class="chip" type="button" data-cmd={c}><span class="prompt">$</span> {c}</button>)}
  </div>
</div>

<script type="application/json" id="console-data" is:inline set:html={JSON.stringify(data)}></script>

<style>
  .term {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }
  .term-screen {
    padding: clamp(1rem, 2.5vw, 1.6rem);
    min-height: clamp(20rem, 46vh, 32rem);
    display: flex;
    flex-direction: column;
    cursor: text;
  }
  .term-banner {
    display: flex;
    align-items: center;
    padding-bottom: 1.2rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .term-logo-lockup {
    height: clamp(68px, 12vw, 110px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 20px rgba(184, 69, 136, 0.45));
    user-select: none;
  }
  .term-out {
    flex: 1;
    overflow-y: auto;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .term-out :global(.ln) {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term-out :global(.ln.out) {
    color: var(--text-muted);
  }
  .term-out :global(a) {
    color: var(--accent-ink);
    border-bottom: 1px dotted var(--line-strong);
  }
  .term-out :global(a:hover) {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .term-out :global(.k) {
    color: var(--accent);
  }
  .term-out :global(.title) {
    color: var(--text);
  }
  .term-in {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .term-input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    caret-color: var(--accent);
    padding: 0;
  }
  .term-input:focus {
    outline: none;
  }
  /* blinking block cursor shown when input is empty & focused */
  .caret {
    width: 0.6em;
    height: 1.1em;
    background: var(--accent);
    box-shadow: var(--accent-glow);
    animation: blink 1.1s steps(1) infinite;
    margin-left: -0.4rem;
  }
  .term-in:focus-within .caret {
    display: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .term-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.8rem clamp(1rem, 2.5vw, 1.6rem) 1.1rem;
    border-top: 1px solid var(--line);
    background: var(--bg-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var dataEl = document.getElementById("console-data");
    if (!dataEl) return;
    var D = JSON.parse(dataEl.textContent);
    var out = document.getElementById("term-out");
    var form = document.getElementById("term-form");
    var input = document.getElementById("term-input");
    var chips = document.getElementById("term-chips");
    var hist = [];
    var hi = -1;

    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
      });
    }
    function line(html, cls) {
      var d = document.createElement("div");
      d.className = "ln" + (cls ? " " + cls : "");
      d.innerHTML = html;
      out.appendChild(d);
      return d;
    }
    function gap() {
      line("");
    }
    function scroll() {
      out.scrollTop = out.scrollHeight;
    }
    function link(label, href) {
      return '<a href="' + href + '">' + esc(label) + "</a>";
    }

    var COMMANDS = {
      help: function () {
        line('<span class="title">' + esc(D.helpTitle) + "</span>", "out");
        D.help.forEach(function (h) {
          line(
            '<span class="k">' +
              esc(h.cmd) +
              "</span>" +
              "  ".repeat(Math.max(1, 14 - h.cmd.length)) +
              '<span class="out">' +
              esc(h.desc) +
              "</span>"
          );
        });
      },
      whoami: function () {
        line('<span class="out">' + esc(D.about) + "</span>");
      },
      ls: function () {
        line(
          D.sections
            .map(function (s) {
              return link(s.name + "/", s.url);
            })
            .join("   ")
        );
      },
      projects: function () {
        D.projects.forEach(function (p, i) {
          line(
            '<span class="k">' +
              String(i + 1).padStart(2, "0") +
              "</span>  " +
              esc(p)
          );
        });
      },
      papers: function (args) {
        var list = D.papers;
        var yi = args.indexOf("--year");
        if (yi >= 0 && args[yi + 1]) {
          var y = parseInt(args[yi + 1], 10);
          list = list.filter(function (p) {
            return p.year === y;
          });
        }
        if (!list.length) {
          line('<span class="out">no papers found.</span>');
          return;
        }
        list.forEach(function (p) {
          line(
            '<span class="k">' +
              p.year +
              "</span>  " +
              link(p.label, p.href)
          );
        });
      },
      team: function () {
        D.team.forEach(function (m) {
          line(
            '<span class="title">' +
              esc(m.name) +
              "</span>  " +
              '<span class="out">' +
              esc(m.role) +
              "</span>"
          );
        });
      },
      blog: function () {
        D.blog.forEach(function (b) {
          line(
            '<span class="out">' + esc(b.date) + "</span>  " + link(b.title, b.href)
          );
        });
      },
      contact: function () {
        line("email   " + link(D.contact.email, "mailto:" + D.contact.email));
        D.contact.links.forEach(function (l) {
          line(esc(l.label.toLowerCase()) + "   ".repeat(2) + link(l.href, l.href));
        });
      },
      clear: function () {
        out.innerHTML = "";
        return true;
      },
      lang: function () {
        location.href = D.altLangHome;
        return true;
      }
    };
    COMMANDS["research"] = COMMANDS.projects;
    COMMANDS["about"] = COMMANDS.whoami;
    COMMANDS["?"] = COMMANDS.help;
    var OPEN = { team: 1, papers: 1, blog: 1, projects: 1, research: 1, contact: 1 };

    function run(raw) {
      var cmd = (raw || "").trim();
      line('<span class="prompt">trex.ai:~$</span> ' + esc(cmd));
      if (!cmd) {
        scroll();
        return;
      }
      hist.push(cmd);
      hi = hist.length;
      var parts = cmd.split(/\s+/);
      var name = parts[0].toLowerCase();
      var args = parts.slice(1);

      if ((name === "open" || name === "cd" || name === "go") && args[0]) {
        var sec = D.sections.filter(function (s) {
          return s.name === args[0].toLowerCase();
        })[0];
        if (sec) {
          location.href = sec.url;
          return;
        }
      }
      var fn = COMMANDS[name];
      if (fn) {
        var cleared = fn(args);
        if (!cleared) gap();
      } else {
        line(
          '<span class="out">' +
            esc(name) +
            ": " +
            esc(D.notFound) +
            "</span>"
        );
        gap();
      }
      scroll();
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      run(input.value);
      input.value = "";
    });
    input.addEventListener("keydown", function (e) {
      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (hi > 0) input.value = hist[--hi] || "";
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (hi < hist.length - 1) input.value = hist[++hi] || "";
        else {
          hi = hist.length;
          input.value = "";
        }
      } else if (e.key === "Tab") {
        e.preventDefault();
        var v = input.value.trim().toLowerCase();
        if (v) {
          var all = Object.keys(COMMANDS).concat(["open"]);
          var hit = all.filter(function (c) {
            return c.indexOf(v) === 0;
          })[0];
          if (hit) input.value = hit + " ";
        }
      }
    });
    chips.addEventListener("click", function (e) {
      var b = e.target.closest("[data-cmd]");
      if (!b) return;
      run(b.getAttribute("data-cmd"));
      input.value = "";
      input.focus();
    });
    document.querySelector(".term-screen").addEventListener("click", function (e) {
      if (e.target.tagName !== "A") input.focus();
    });
  })();
</script>
