---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsTicker from "../components/NewsTicker.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  image?: string;
  ogType?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = Astro.props.title
  ? `${Astro.props.title} · ${t("site.name")}`
  : `${t("site.name")} — ${t("site.tagline")}`;
const description = Astro.props.description ?? t("site.description");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon-192.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0e12" />

    <script is:inline>
      (function () {
        var t = localStorage.getItem("trex-theme");
        if (t === "pink") document.documentElement.setAttribute("data-theme", "pink");
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
    />

    <SEO
      title={title}
      description={description}
      lang={lang}
      image={Astro.props.image}
      ogType={Astro.props.ogType}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} />
    <NewsTicker lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--accent);
        color: var(--accent-contrast);
        font-family: var(--font-mono);
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.6rem 1rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 0;
      }
      main {
        min-height: 60vh;
      }
    </style>
  </body>
</html>
